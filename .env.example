PORT=8765
ARUS_HOST=127.0.0.1
ARUS_APP_URL=http://127.0.0.1:8765
ARUS_ALLOW_REGISTER=false
ARUS_SCHEDULER=true
# Local: leave empty. Hosting: Supabase session pooler connection string + sslmode=require.
DATABASE_URL=
# Local Gmail SMTP (Google App Password, NOT normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# HTTPS alternative for free hosting, see docs/GMAIL.md.
GMAIL_GATEWAY_URL=
GMAIL_GATEWAY_SECRET=
ARUS_CRON_SECRET=
OLLAMA_MODEL=
